menu "IHearYou Firmware Configuration"

    choice BOARD_TYPE
        prompt "Target Board"
        default BOARD_RESPEAKER_LITE
        help
            Select the target ReSpeaker board variant.

        config BOARD_RESPEAKER_LITE
            bool "ReSpeaker Lite (XMOS XU316, 2-mic)"
            help
                ReSpeaker Lite with XMOS XU316 DSP and dual microphone array.
                Supports: IC, AEC, NS, AGC
                I2S Mode: Slave (XU316 is master)

        config BOARD_RESPEAKER_XVF3800
            bool "ReSpeaker XVF3800 (4-mic, advanced DSP)"
            help
                ReSpeaker XVF3800 with 4-microphone circular array.
                Supports: AEC, Beamforming, De-reverb, DNN-NS, DoA, VAD, AGC
                I2S Mode: Slave (XVF3800 is master)
    endchoice

    menu "Network Configuration"

        config WIFI_SSID
            string "WiFi SSID"
            default "myssid"
            help
                SSID of the WiFi network to connect to.

        config WIFI_PASSWORD
            string "WiFi Password"
            default "mypassword"
            help
                Password for the WiFi network.

        config SERVER_HOST
            string "Server IP Address"
            default "192.168.1.100"
            help
                IP address of the machine running respeaker_service.py

        config SERVER_PORT
            int "Server Port"
            default 8010
            range 1 65535
            help
                TCP port for the respeaker service.

        config WIFI_MAXIMUM_RETRY
            int "Maximum WiFi Retry"
            default 10
            range 1 100
            help
                Maximum number of retries for WiFi connection.

        config RECONNECT_DELAY_MS
            int "Reconnect Delay (ms)"
            default 1000
            range 100 10000
            help
                Delay between reconnection attempts.

    endmenu

    menu "Audio Configuration"

        config VAD_THRESHOLD
            int "VAD Energy Threshold"
            default 150 if BOARD_RESPEAKER_LITE
            default 80 if BOARD_RESPEAKER_XVF3800
            range 10 1000
            help
                Energy threshold for voice activity detection.
                Higher values = less sensitive, fewer false positives.
                ReSpeaker Lite typically needs higher threshold due to less NS.

        config VAD_HANGOVER_MS
            int "VAD Hangover Time (ms)"
            default 500
            range 100 2000
            help
                Time to continue streaming after speech ends.

        config AUDIO_CHUNK_DURATION_S
            int "Audio Chunk Duration (seconds)"
            default 5
            range 1 30
            help
                Duration of audio chunks sent to server.

        config RING_BUFFER_SIZE_KB
            int "Ring Buffer Size (KB)"
            default 512
            range 64 2048
            help
                Size of the audio ring buffer in PSRAM.
                Must be large enough to handle network outages.

    endmenu

    menu "XVF3800 Configuration"
        depends on BOARD_RESPEAKER_XVF3800

        config XVF3800_AGC_ENABLED
            bool "Enable XVF3800 AGC"
            default n
            help
                Enable Automatic Gain Control on XVF3800.
                WARNING: AGC may affect amplitude-based depression indicators.
                Disable for depression detection use case.

        config XVF3800_DEREVERB_ENABLED
            bool "Enable XVF3800 De-reverberation"
            default y
            help
                Enable de-reverberation on XVF3800.
                Recommended for cleaner formant extraction.

        config XVF3800_BEAM_MODE
            int "Beamforming Mode"
            default 1
            range 0 1
            help
                0 = Fixed beam (forward-facing)
                1 = Adaptive beam (tracks speaker)

        config XVF3800_INCLUDE_DOA
            bool "Include Direction of Arrival in Metadata"
            default y
            help
                Query and include DoA azimuth in audio chunk metadata.
                Useful for psychomotor indicators research.

    endmenu

    menu "Debug Configuration"

        config ENABLE_AUDIO_DEBUG
            bool "Enable Audio Debug Output"
            default n
            help
                Enable verbose audio pipeline debugging.

        config ENABLE_NETWORK_DEBUG
            bool "Enable Network Debug Output"
            default n
            help
                Enable verbose network debugging.

        config ENABLE_TELEMETRY
            bool "Enable Firmware Telemetry"
            default y
            help
                Enable periodic telemetry reporting.

    endmenu

endmenu
